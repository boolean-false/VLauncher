{
  "name": "vlauncher-client",
  "private": true,
  "version": "1.3.2",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/boolean-false/VLauncher.git"
  },
  "homepage": "https://vlauncher.space",
  "bugs": "https://github.com/boolean-false/VLauncher/issues",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:windows": "tauri build --bundles nsis --config src-tauri/tauri.unsigned.conf.json",
    "preview": "vite preview",
    "tauri": "node --env-file-if-exists=.env.local ./node_modules/@tauri-apps/cli/tauri.js",
    "dev:desktop": "npm run tauri -- dev",
    "build:rust": "cargo build --manifest-path src-tauri/Cargo.toml",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "check:design-system": "node scripts/check-design-system.mjs",
    "check": "npm run build && npm run test:cache && npm run check:design-system",
    "licenses:npm": "node scripts/generate-npm-licenses.mjs",
    "licenses:rust": "cargo about generate --locked --fail --manifest-path src-tauri/Cargo.toml --output-file RUST_THIRD_PARTY_LICENSES.html about.hbs && node scripts/normalize-text-file.mjs RUST_THIRD_PARTY_LICENSES.html",
    "icons": "node scripts/generate-icons.mjs",
    "test:cache": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-deep-link": "^2.4.10",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "axe-core": "^4.13.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
